# Canonical platform vars. Secrets are NOT here — they live in Infisical.
# This file documents names and safe defaults only.

APP_ENV=production
APP_URL=https://api.rehearseio.triptribe.info
PORT=9000
LOG_LEVEL=info

# Internal host (app container on the Dokploy network)
DATABASE_URL=postgresql://rehearse_io:changeme@postgres:5432/rehearse_io_prod
# External host:port, used only by CI to run migrations
DATABASE_URL_EXTERNAL=postgresql://rehearse_io:changeme@203.0.113.10:5432/rehearse_io_prod
DATABASE_POOL_MAX=10

# Required. Signs session JWTs.
JWT_SECRET=changeme
# Required for prod PII encryption: openssl rand -hex 32
ENCRYPTION_KEY=

# Backend -> AI service shared secret. Must match ai-service API_KEY.
AI_SERVICE_URL=http://ai-service:8000
AI_SERVICE_API_KEY=changeme

# Comma-separated browser origins allowed by CORS.
ALLOWED_ORIGINS=https://rehearseio.triptribe.info
# Legacy alias still read for the client redirect URL.
CLIENT_URL=https://rehearseio.triptribe.info

# Rate limits (per window)
AUTH_RATE_MAX=10
AUTH_RATE_WINDOW_MS=900000
RATE_MAX=1000
RATE_WINDOW_MS=900000

# Frontend build-time var (Cloudflare Pages). Baked into the bundle.
VITE_API_URL=https://api.rehearseio.triptribe.info
