# Rehearse.io Environment Variables

# Backend
JWT_SECRET=your_jwt_secret_here
MONGO_URI=mongodb://admin:password@localhost:27017/rehearse?authSource=admin
MONGO_USERNAME=admin
MONGO_PASSWORD=your_mongo_password_here
PORT=9000
NODE_ENV=development

# PII encryption at rest (32-byte key, hex or base64). Generate with: openssl rand -hex 32
ENCRYPTION_KEY=your_32_byte_hex_encryption_key_here

# AI Service (backend -> local FastAPI AI service)
AI_SERVICE_URL=http://localhost:8000
# Shared secret for backend -> AI service authentication (must match on both sides)
AI_SERVICE_API_KEY=your_ai_service_api_key_here

# LLM + STT + TTS provider (Groq)
GROQ_API_KEY=your_groq_api_key_here
LITELLM_MODEL=groq/llama-3.3-70b-versatile

# Frontend (built at compile time)
VITE_API_URL=http://localhost:9000

# Rate Limiting
RATE_MAX=1000
AUTH_RATE_MAX=10
