# Rehearse.io AI Service environment variables

# Shared secret for backend -> AI service authentication.
# Must match the backend's AI_SERVICE_API_KEY. Leave empty to disable auth (dev only).
API_KEY=

# Groq API key — powers STT (Whisper), TTS (PlayAI), and LLM (via litellm).
GROQ_API_KEY=your_groq_api_key_here

# LLM model used by litellm for scenario generation, audio and DSA evaluation.
LITELLM_MODEL=groq/llama-3.3-70b-versatile

# Groq Whisper model for speech-to-text.
STT_MODEL=whisper-large-v3

# Groq PlayAI TTS model and default voice.
TTS_MODEL=playai-tts
TTS_VOICE=Fritz-PlayAI

# CORS allowlist (comma-separated).
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Maximum audio upload size (MB).
MAX_AUDIO_SIZE_MB=25
