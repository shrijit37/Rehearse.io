# Rehearse.io AI Service environment variables

# Shared secret for backend -> AI service authentication.
# Must match the backend's AI_SERVICE_API_KEY. Leave empty to disable auth (dev only).
API_KEY=

# Text inference — any OpenAI-compatible chat-completions endpoint. Point
# LLM_BASE_URL at a hosted API (e.g. https://api.groq.com/openai/v1) or a
# self-hosted gateway; LLM_MODEL is the model name that endpoint serves;
# LLM_API_KEY is sent as the bearer token (leave empty only for an endpoint
# that takes none). While LLM_BASE_URL or LLM_MODEL is unset, text inference
# reports unavailable on /health and its endpoints answer 503.
LLM_BASE_URL=
LLM_MODEL=
LLM_API_KEY=

# CORS allowlist (comma-separated).
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Runtime environment (same var the backend reads). "production" (or
# NODE_ENV=production) makes the service refuse to start when API_KEY is unset.
APP_ENV=development
