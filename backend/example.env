# Rehearse.io Backend environment variables
# Copy to .env:  cp example.env .env

# Server
PORT=9000
APP_ENV=development          # development | production | test
CLIENT_URL=http://localhost:5173

# MongoDB — required (accepts MONGODB_URI or legacy MONGO_URI)
MONGODB_URI=mongodb://localhost:27017/rehearse

# JWT — required, no default; fails fast if unset
JWT_SECRET=change-me-to-a-long-random-secret

# CORS allow-list (comma-separated). Defaults to CLIENT_URL when unset.
# ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# AI service
AI_SERVICE_URL=http://localhost:8000
AI_SERVICE_API_KEY=           # must match the ai-service API_KEY

# PII encryption (optional but recommended in production).
# Generate with: openssl rand -hex 32
ENCRYPTION_KEY=

# Optional S3 — the app stores PII base64 in MongoDB (encrypted); S3 is best-effort.
# AWS_REGION=
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_BUCKET_NAME=

# Rate limiting (optional)
# AUTH_RATE_MAX=10
# AUTH_RATE_WINDOW_MS=900000
# RATE_MAX=1000
# RATE_WINDOW_MS=900000

# Audio upload limit (MB) — keep in sync with ai-service MAX_AUDIO_SIZE_MB
# MAX_AUDIO_SIZE_MB=25
