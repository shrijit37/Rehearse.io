#!/usr/bin/env bash
# Developer entry point for Rehearse.io — the local stack, in one command.
#
#   ./scripts/dev local   full local stack: Postgres (dev DB) -> migrations ->
#                         seeds -> dev auth -> ai-service -> API -> web
#
# Why the stack runs its own auth service: sign-in is delegated to a shared
# auth service that sets a `.shrijit.tech` cookie, and a browser never sends
# that cookie to localhost, so a localhost API cannot be authenticated by the
# deployed service. The stack runs a stand-in on localhost instead
# (`backend/scripts/dev-auth.ts`); see that file's header.
#
# Options:
#   --stop       stop the running dev stack and exit
#   --fresh      drop and recreate the dev database first
#   --no-ai      skip the ai-service
#   -h, --help   this text
#
# Ports (env-overridable): WEB_PORT=5173 API_PORT=9000 AI_PORT=8000
#                          DEV_AUTH_PORT=4000
# Logs: .dev/logs/<service>.log (also streamed, prefixed, to this terminal)
# State: .dev/ — pid file, logs, and the auth stand-in's own state; both
#        git-ignored.
#
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$ROOT"

MODE="local"
ACTION="start"
FRESH=0
NO_AI=0

usage() {
    sed -n '2,24p' "${BASH_SOURCE[0]}" | sed 's/^# \{0,1\}//'
}

while (($#)); do
    case "$1" in
        local) MODE="$1" ;;
        --stop) ACTION="stop" ;;
        --fresh) FRESH=1 ;;
        --no-ai) NO_AI=1 ;;
        -h | --help)
            usage
            exit 0
            ;;
        *)
            echo "unknown argument: $1" >&2
            echo >&2
            usage >&2
            exit 2
            ;;
    esac
    shift
done

WEB_PORT="${WEB_PORT:-5173}"
API_PORT="${API_PORT:-9000}"
AI_PORT="${AI_PORT:-8000}"
DEV_AUTH_PORT="${DEV_AUTH_PORT:-4000}"
DATABASE_URL="${DATABASE_URL:-}"
DEV_PG_DIR="${DEV_PG_DIR:-$HOME/.local/share/rehearse-pg}"
# The password for the seeded local accounts. It exists nowhere else in source:
# this is the value the stand-in enforces and the one the summary prints, and a
# real environment (or CI) can override it. The accounts are local-only.
DEV_AUTH_PASSWORD="${DEV_AUTH_PASSWORD:-admin123}"

STATE_DIR="$ROOT/.dev"
LOG_DIR="$STATE_DIR/logs"
PID_FILE="$STATE_DIR/pids"
mkdir -p "$LOG_DIR"

if [[ -t 1 && -z "${NO_COLOR:-}" ]]; then
    B=$'\e[1m'
    DIM=$'\e[2m'
    RED=$'\e[31m'
    GREEN=$'\e[32m'
    YELLOW=$'\e[33m'
    BLUE=$'\e[34m'
    MAGENTA=$'\e[35m'
    CYAN=$'\e[36m'
    R=$'\e[0m'
else
    B="" DIM="" RED="" GREEN="" YELLOW="" BLUE="" MAGENTA="" CYAN="" R=""
fi

say() { printf '%s==>%s %s\n' "$B$CYAN" "$R" "$*"; }
warn() { printf '%s!!%s  %s\n' "$B$YELLOW" "$R" "$*" >&2; }
die() {
    printf '%sxx%s  %s\n' "$B$RED" "$R" "$*" >&2
    exit 1
}

# --- process and port helpers ------------------------------------------------

port_pids() {
    ss -ltnpH "sport = :$1" 2>/dev/null | grep -oE 'pid=[0-9]+' | cut -d= -f2 | sort -u
}

pid_alive() { kill -0 "$1" 2>/dev/null; }

cmdline_of() { [[ -r "/proc/$1/cmdline" ]] || return 0; tr '\0' ' ' <"/proc/$1/cmdline" 2>/dev/null | sed 's/ *$//'; }

# A process belongs to this checkout when it is running from inside it: this is
# what makes stale-stack cleanup safe — never anything else on the port.
is_repo_process() {
    local pid="$1" cwd
    cwd="$(readlink -f "/proc/$pid/cwd" 2>/dev/null || true)"
    [[ -n "$cwd" && "$cwd" == "$ROOT"/* ]] && return 0
    [[ "$(cmdline_of "$pid")" == *"$ROOT"* ]] && return 0
    return 1
}

# TERM the whole process group first (services are started with setsid, so the
# group covers watchers and reloader children), then KILL whatever survived.
stop_pid() {
    local pid="$1"
    pid_alive "$pid" || return 0
    kill -TERM -- "-$pid" 2>/dev/null || kill -TERM "$pid" 2>/dev/null || true
    for _ in $(seq 1 25); do
        pid_alive "$pid" || return 0
        sleep 0.2
    done
    warn "pid $pid did not exit on SIGTERM; killing it"
    kill -KILL -- "-$pid" 2>/dev/null || kill -KILL "$pid" 2>/dev/null || true
}

# Stops every process this checkout owns on the given ports, plus anything the
# pid file remembers. Foreign processes are reported, never killed — and the pid
# file outlives a crash or a reboot, so a recorded pid may since have been
# handed to an unrelated program.
stop_stack() {
    local port pid name stopped=0
    if [[ -f "$PID_FILE" ]]; then
        while read -r name pid; do
            pid_alive "$pid" || continue
            if is_repo_process "$pid"; then
                say "stopping $name (pid $pid)"
                stop_pid "$pid"
                stopped=1
            else
                warn "$name (pid $pid) no longer belongs to this checkout; skipping"
            fi
        done <"$PID_FILE"
        rm -f "$PID_FILE"
    fi
    rm -f "$STATE_DIR"/*.pid
    for port in "$@"; do
        for pid in $(port_pids "$port"); do
            pid_alive "$pid" || continue
            if is_repo_process "$pid"; then
                say "stopping stale Rehearse process on :$port (pid $pid)"
                stop_pid "$pid"
                stopped=1
            else
                warn ":$port is held by an unrelated process (pid $pid: $(cmdline_of "$pid"))"
            fi
        done
    done
    [[ "$stopped" == 0 ]] && say "no dev stack was running"
    return 0
}

PORT_VAR_FOR() {
    case "$1" in
        web) echo WEB_PORT ;;
        api) echo API_PORT ;;
        ai) echo AI_PORT ;;
        auth) echo DEV_AUTH_PORT ;;
        *) echo "PORT" ;;
    esac
}

# Frees the given name:port pairs for this run: stale processes of this
# checkout are stopped, anything foreign is a hard error with the way out.
claim_ports() {
    local pair port pid name
    for pair in "$@"; do
        name="${pair%%:*}"
        port="${pair##*:}"
        for pid in $(port_pids "$port"); do
            pid_alive "$pid" || continue
            if is_repo_process "$pid"; then
                say "port $port still held by a stale dev process (pid $pid); stopping it"
                stop_pid "$pid"
            else
                die "port $port is in use by pid $pid ($(cmdline_of "$pid")) — stop it, or run with $(PORT_VAR_FOR "$name")=<other port>"
            fi
        done
    done
}

# --- service lifecycle -------------------------------------------------------

declare -A PIDS=()
declare -a SERVICE_NAMES=()
declare -a TAILERS=()
CLEANUP_DONE=0

# start_service <name> <colour> <dir> <cmd...>
# Own session per service (setsid) so Ctrl-C cleanup reaches every descendant;
# the pid is written by the child itself, so it survives setsid forking.
start_service() {
    local name="$1" colour="$2" dir="$3"
    shift 3
    local log="$LOG_DIR/$name.log"
    local pid_file="$STATE_DIR/$name.pid"
    : >"$log"
    # Remove any previous pid file first: reading a stale one would record a
    # dead pid for a live service (the monitor then kills the whole stack).
    rm -f "$pid_file"
    # `9>&-`: the service must not inherit the run lock (fd 9) — a service or
    # tailer that outlives this script would otherwise hold it forever and every
    # later run would be refused as "another ./scripts/dev is running".
    setsid bash -c 'echo "$$" >"$1"; shift; cd "$1"; shift; exec "$@"' _ "$pid_file" "$dir" "$@" >>"$log" 2>&1 9>&- &
    local waited=0
    while [[ ! -s "$pid_file" ]] && ((waited < 100)); do
        sleep 0.1
        waited=$((waited + 1))
    done
    local pid
    pid="$(cat "$pid_file" 2>/dev/null || true)"
    [[ -n "$pid" ]] || die "$name did not start (see $log)"
    pid_alive "$pid" || die "$name exited immediately (see $log)"
    PIDS["$name"]="$pid"
    SERVICE_NAMES+=("$name")
    printf '%s %s\n' "$name" "$pid" >>"$PID_FILE"
    (tail -n +1 -F "$log" 2>/dev/null | sed -u "s/^/${colour}[${name}]${R} /") 9>&- &
    TAILERS+=($!)
    say "$name started (pid $pid, log $log)"
}

# Waits for a service's health endpoint. Returns non-zero when the budget runs
# out — it does not decide whether that is fatal: the caller does, because the
# ai-service is optional and the rest are not.
wait_for_http() {
    local name="$1" url="$2" budget="${3:-60}" waited=0
    while ! curl -fsS --max-time 5 "$url" >/dev/null 2>&1; do
        if ((waited >= budget)); then
            warn "$name is not answering $url after ${budget}s"
            tail -n 25 "$LOG_DIR/$name.log" >&2 || true
            return 1
        fi
        sleep 1
        waited=$((waited + 1))
    done
    say "$name ready ($url)"
}

log_tail_lines() {
    local file="$1" lines="${2:-25}"
    printf '%s----- last %s lines of %s -----%s\n' "$DIM" "$lines" "$file" "$R" >&2
    tail -n "$lines" "$file" >&2 || true
    printf '%s--------------------------------%s\n' "$DIM" "$R" >&2
}

cleanup() {
    [[ "$CLEANUP_DONE" == 1 ]] && return 0
    CLEANUP_DONE=1
    trap - EXIT INT TERM
    local pid name
    for pid in ${TAILERS[@]+"${TAILERS[@]}"}; do kill "$pid" 2>/dev/null || true; done
    for name in ${SERVICE_NAMES[@]+"${SERVICE_NAMES[@]}"}; do
        pid="${PIDS[$name]:-}"
        [[ -n "$pid" ]] && stop_pid "$pid"
    done
    rm -f "$PID_FILE"
    rm -f "$STATE_DIR"/*.pid
    printf '\n%s==>%s dev stack stopped\n' "$B$CYAN" "$R"
}

# Watches the stack: the first service that dies takes the whole stack down —
# a live frontend over a dead API only produces confusing 500s. Prints that
# service's log tail, which is what interleaved terminal output never does.
monitor() {
    local name pid
    while true; do
        for name in "${SERVICE_NAMES[@]}"; do
            pid="${PIDS[$name]}"
            if ! pid_alive "$pid"; then
                warn "$name exited unexpectedly (pid $pid)"
                log_tail_lines "$LOG_DIR/$name.log" 30
                return 1
            fi
        done
        sleep 2
    done
}

require_deps() {
    command -v bun >/dev/null || die "bun is required (backend runtime) — see https://bun.sh"
    command -v npm >/dev/null || die "npm is required (frontend dev server)"
    command -v curl >/dev/null || die "curl is required"
    [[ -d "$ROOT/backend/node_modules" ]] || die "backend deps are missing — run make setup"
    [[ -x "$ROOT/frontend/node_modules/.bin/vite" ]] || die "frontend deps are missing — run make setup"
}

require_backend_env() {
    [[ -f "$ROOT/backend/.env" ]] || die "backend/.env is missing — run make setup (copies backend/example.env)"
    grep -q '^JWT_SECRET=.\+' "$ROOT/backend/.env" || die "backend/.env has no JWT_SECRET — add one (openssl rand -hex 32)"
}

# --- local Postgres ----------------------------------------------------------

pg_field() { # url, field -> value (host/port/db/user)
    URL="$1" FIELD="$2" bun -e '
const u = new URL(process.env.URL);
const fields = {
    host: u.hostname || "localhost",
    port: u.port || "5432",
    user: decodeURIComponent(u.username || "postgres"),
    db: u.pathname.replace(/^\//, ""),
};
console.log(fields[process.env.FIELD] ?? "");
'
}

ensure_database_exists() {
    local host port user db admin_url err
    host="$(pg_field "$DATABASE_URL" host)"
    port="$(pg_field "$DATABASE_URL" port)"
    user="$(pg_field "$DATABASE_URL" user)"
    db="$(pg_field "$DATABASE_URL" db)"
    [[ -n "$db" ]] || die "DATABASE_URL has no database name: $DATABASE_URL"

    if err="$(psql "$DATABASE_URL" -v ON_ERROR_STOP=1 -c 'SELECT 1' 2>&1 >/dev/null)"; then
        return 0
    fi
    case "$err" in
        *'does not exist'*)
            case "$host" in
                localhost | 127.0.0.1 | ::1) ;;
                *) die "database $db does not exist on $host — create it there, or point DATABASE_URL elsewhere" ;;
            esac
            say "creating database $db"
            admin_url="${DATABASE_URL%/*}/postgres"
            psql "$admin_url" -v ON_ERROR_STOP=1 -c "CREATE DATABASE \"$db\"" >/dev/null ||
                die "could not create database $db (is $user allowed to?)"
            ;;
        *'role'*'does not exist'*)
            die "role $user does not exist on $host — start your own Postgres or fix DATABASE_URL"
            ;;
        *)
            die "cannot reach $host:$port ($(printf '%s' "$err" | head -n1)) — start Postgres, or set DATABASE_URL"
            ;;
    esac
}

# Local mode expects the laptop Postgres the platform convention uses:
# postgresql://postgres@localhost:5432/<db>_dev. Starts the repo's own cluster
# when it is down; creates it on a machine that has never had one.
ensure_postgres() {
    local host port pg_port
    host="$(pg_field "$DATABASE_URL" host)"
    port="$(pg_field "$DATABASE_URL" port)"
    case "$host" in
        localhost | 127.0.0.1 | ::1) ;;
        *)
            say "DATABASE_URL points at $host — using it as-is"
            ensure_database_exists
            return 0
            ;;
    esac

    if pg_isready -h "$host" -p "$port" >/dev/null 2>&1; then
        ensure_database_exists
        return 0
    fi

    command -v pg_ctl >/dev/null || die "no Postgres on $host:$port and no pg_ctl to start one — install Postgres, or set DATABASE_URL"
    pg_port="$port"
    if [[ ! -s "$DEV_PG_DIR/PG_VERSION" ]]; then
        command -v initdb >/dev/null || die "no Postgres cluster at $DEV_PG_DIR and no initdb to create one"
        say "creating a local dev Postgres cluster at $DEV_PG_DIR (trust auth, loopback only)"
        mkdir -p "$DEV_PG_DIR"
        initdb -D "$DEV_PG_DIR" -U postgres --auth=trust >/dev/null
    fi
    say "starting Postgres from $DEV_PG_DIR on :$pg_port"
    # `9>&-` as in start_service: the postmaster outlives this script by design
    # (--stop leaves it running), so it must not hold the run lock.
    pg_ctl -D "$DEV_PG_DIR" -l "$LOG_DIR/postgres.log" \
        -o "-p $pg_port -k /tmp -c listen_addresses=127.0.0.1" start >/dev/null 9>&-
    for _ in $(seq 1 30); do
        pg_isready -h "$host" -p "$port" >/dev/null 2>&1 && break
        sleep 0.5
    done
    pg_isready -h "$host" -p "$port" >/dev/null 2>&1 || die "Postgres did not come up (log: $LOG_DIR/postgres.log)"
    ensure_database_exists
}

reset_database() {
    local host db admin_url
    host="$(pg_field "$DATABASE_URL" host)"
    db="$(pg_field "$DATABASE_URL" db)"
    case "$host" in
        localhost | 127.0.0.1 | ::1) ;;
        *) die "--fresh refuses a non-loopback database ($host)" ;;
    esac
    [[ "$db" == *_dev ]] || die "--fresh refuses database '$db' (name must end in _dev)"
    say "--fresh: dropping and recreating $db"
    admin_url="${DATABASE_URL%/*}/postgres"
    psql "$admin_url" -v ON_ERROR_STOP=1 -c "DROP DATABASE IF EXISTS \"$db\" WITH (FORCE)" >/dev/null
    psql "$admin_url" -v ON_ERROR_STOP=1 -c "CREATE DATABASE \"$db\"" >/dev/null
}

# --- env ---------------------------------------------------------------------

DEFAULT_DATABASE_URL="postgresql://postgres@localhost:5432/rehearse_io_dev"

# An inherited DATABASE_URL is used as-is, but only if it is a Postgres URL:
# this repo's root `.env` is a Mongo-era leftover that still exports
# `DATABASE_URL=https://localhost:27017`, and tools that load a workspace .env
# (or a shell that sourced it) would otherwise aim the stack at a nonexistent
# server on the old Mongo port.
resolve_database_url() {
    if [[ -z "$DATABASE_URL" ]]; then
        DATABASE_URL="$DEFAULT_DATABASE_URL"
        return 0
    fi
    if [[ ! "$DATABASE_URL" =~ ^postgres(ql)?:// ]]; then
        warn "ignoring DATABASE_URL=$DATABASE_URL (not a postgres:// URL); using $DEFAULT_DATABASE_URL"
        DATABASE_URL="$DEFAULT_DATABASE_URL"
    fi
}

backend_env_has() { [[ -f "$ROOT/backend/.env" ]] && grep -qE "^$1=.+" "$ROOT/backend/.env"; }

# The value the backend will send as `Authorization: Bearer` to the ai-service.
# Local mode passes the same value to the ai-service as API_KEY so the pair
# always matches — the old flow only worked when both files happened to agree.
backend_ai_service_key() {
    local value
    value="$(grep -E '^AI_SERVICE_API_KEY=' "$ROOT/backend/.env" 2>/dev/null | tail -n1 | cut -d= -f2- || true)"
    # Strip one layer of surrounding quotes, as dotenv would.
    value="${value%\"}"
    value="${value#\"}"
    value="${value%\'}"
    value="${value#\'}"
    printf '%s' "$value"
}

local_env() {
    # One loopback host for page, API and dev auth. The session cookie is
    # host-scoped and SameSite=Lax, so a page served from `localhost` cannot
    # authenticate an API reached at `127.0.0.1` (the two are different sites) —
    # prod works because page, API and auth are all siblings under one domain.
    export DATABASE_URL
    export AUTH_URL="http://127.0.0.1:$DEV_AUTH_PORT"
    export PORT="$API_PORT"
    export APP_ENV="development"
    export CLIENT_URL="http://127.0.0.1:$WEB_PORT"
    export AI_SERVICE_URL="http://127.0.0.1:$AI_PORT"
    # The SPA is served from 127.0.0.1:<WEB_PORT>; every spelling of that origin
    # is allowed, so a hard CORS error (rather than a silent cookie failure)
    # shows up if the browser is pointed at a different one.
    export ALLOWED_ORIGINS="http://127.0.0.1:$WEB_PORT,http://localhost:$WEB_PORT,http://127.0.0.1:5173,http://localhost:5173,http://localhost:3000"
    # The dev-auth stand-in refuses to start without it, and the summary below
    # prints it: exporting this script's resolved value is what keeps the printed
    # credentials and the password it enforces the same value.
    export DEV_AUTH_PASSWORD
}

summary_local() {
    local api_base="http://127.0.0.1:$API_PORT" web_base="http://127.0.0.1:$WEB_PORT" voice dsa ai_note=""
    [[ "$NO_AI" == 1 ]] && ai_note=" (skipped: --no-ai)"
    if backend_env_has GEMINI_API_KEY && backend_env_has LIVE_TICKET_SECRET; then
        voice="${GREEN}enabled${R} (GEMINI_API_KEY + LIVE_TICKET_SECRET in backend/.env)"
    else
        voice="${YELLOW}disabled${R} — voice routes answer 503 (set GEMINI_API_KEY + LIVE_TICKET_SECRET in backend/.env; see VOICE.md)"
    fi
    if curl -fsS --max-time 5 "http://127.0.0.1:$AI_PORT/health" 2>/dev/null | grep -q '"llm_available":true'; then
        dsa="${GREEN}enabled${R} (ai-service has an LLM endpoint)"
    elif curl -fsS --max-time 5 "http://127.0.0.1:$AI_PORT/health" >/dev/null 2>&1; then
        dsa="${YELLOW}disabled${R} — DSA routes answer 503 (set LLM_BASE_URL/LLM_MODEL in ai-service/.env)"
    else
        dsa="${YELLOW}unavailable${R} — ai-service is not running"
    fi

    cat <<EOF

${B}Local stack ready${R}  (mode: local — API, database and auth are all on this machine)

  web        $web_base
  api        $api_base        /health
  dev auth   http://127.0.0.1:$DEV_AUTH_PORT  (local stand-in for auth.shrijit.tech)
  ai-service http://127.0.0.1:$AI_PORT$ai_note
  database   $DATABASE_URL

  ${B}Test accounts${R} — local dev only, they do not exist on auth.shrijit.tech:
    candidate@shrijit.tech / $DEV_AUTH_PASSWORD   candidate, onboarding already done
    recruiter@shrijit.tech / $DEV_AUTH_PASSWORD   recruiter, org "Dev Org"

  Sign in: open $web_base/signup and click "Sign in".
  Use that exact host (127.0.0.1, not localhost): the session cookie is
  host-scoped, and prod works only because page, API and auth share one domain.

  voice  $voice
  DSA    $dsa

  Logs: $LOG_DIR/<service>.log   Stop: ./scripts/dev --stop   Reset data: ./scripts/dev local --fresh

EOF
}

# --- modes -------------------------------------------------------------------

run_local() {
    require_deps
    require_backend_env
    [[ -f "$ROOT/ai-service/.env" ]] || {
        cp "$ROOT/ai-service/.env.example" "$ROOT/ai-service/.env"
        say "created ai-service/.env from .env.example"
    }

    ensure_postgres
    [[ "$FRESH" == 1 ]] && reset_database

    say "applying migrations"
    DATABASE_URL="$DATABASE_URL" "$ROOT/scripts/migrate"

    say "seeding test accounts"
    (cd "$ROOT/backend" && DATABASE_URL="$DATABASE_URL" bun run seed:dev) || die "seeding failed"

    local ai_runner=()
    if [[ "$NO_AI" == 1 ]]; then
        say "--no-ai: skipping the ai-service"
    elif [[ -x "$ROOT/ai-service/.venv/bin/python" ]]; then
        ai_runner=("$ROOT/ai-service/.venv/bin/python" -m uvicorn main:app --reload --app-dir app --host 127.0.0.1 --port "$AI_PORT")
    elif command -v uvicorn >/dev/null; then
        ai_runner=(uvicorn main:app --reload --app-dir app --host 127.0.0.1 --port "$AI_PORT")
    else
        warn "ai-service deps are not installed (no ai-service/.venv, no uvicorn) — DSA features will answer 503"
    fi

    claim_ports "auth:$DEV_AUTH_PORT" "api:$API_PORT" "web:$WEB_PORT"
    [[ ${#ai_runner[@]} -gt 0 ]] && claim_ports "ai:$AI_PORT"

    local_env
    local web_env=(env "VITE_API_URL=http://127.0.0.1:$API_PORT" "VITE_AUTH_URL=http://127.0.0.1:$DEV_AUTH_PORT")

    start_service auth "$MAGENTA" "$ROOT/backend" bun run dev-auth
    if [[ ${#ai_runner[@]} -gt 0 ]]; then
        start_service ai "$BLUE" "$ROOT/ai-service" env "API_KEY=$(backend_ai_service_key)" "${ai_runner[@]}"
    fi
    start_service api "$GREEN" "$ROOT/backend" bun run start
    start_service web "$CYAN" "$ROOT/frontend" "${web_env[@]}" npm run dev -- --port "$WEB_PORT" --strictPort --host 127.0.0.1

    # The three the stack is useless without: a timeout here stops the run, which
    # takes the whole stack down through the EXIT trap.
    wait_for_http auth "http://127.0.0.1:$DEV_AUTH_PORT/__dev/health" 30 || die "auth failed to start"
    wait_for_http api "http://127.0.0.1:$API_PORT/health" 90 || die "api failed to start"
    wait_for_http web "http://127.0.0.1:$WEB_PORT/" 60 || die "web failed to start"
    # The ai-service is optional: DSA and resume reads answer 503 without it, so a
    # slow start is a warning and the stack stays up. (It is started above, so a
    # timeout here is a slow/down service, not a missing one.)
    if [[ ${#ai_runner[@]} -gt 0 ]]; then
        wait_for_http ai "http://127.0.0.1:$AI_PORT/health" 60 || warn "ai-service is slow; continuing without it"
    fi

    summary_local
    monitor || exit 1
}

# --- entry -------------------------------------------------------------------

case "$ACTION" in
    stop)
        # `--stop` means "stop this checkout's dev stack, whichever mode it is":
        # the pid file covers the stack this script started, and the port scan
        # covers one whose pid file is gone (killed terminal, reboot). Only
        # processes running out of this checkout are ever touched.
        stop_stack "$DEV_AUTH_PORT" "$API_PORT" "$AI_PORT" "$WEB_PORT"
        exit 0
        ;;
    start) ;;
esac

# One managed stack at a time; a crashed run is recovered through the pid file
# and the port owner check, so no lock is needed for that.
# `exec` is load-bearing: a redirection attached to the `if` is undone when the
# compound command ends, which would drop the lock immediately and let a second
# run treat the live stack as stale (claim_ports would then kill it).
exec 9>"$STATE_DIR/lock"
if ! flock -n 9; then
    die "another ./scripts/dev is running (or --stop it first)"
fi

trap cleanup EXIT
trap 'exit 130' INT TERM

resolve_database_url

case "$MODE" in
    local) run_local ;;
    *) die "unknown mode: $MODE" ;;
esac
