#!/usr/bin/env bash
# Supabase schema verification. The authoritative DDL is
# `supabase/migrations/0001_fleet_schema.sql`; it is applied out-of-band through
# the Supabase dashboard/CLI because raw Postgres is private and the app
# container (and CI) can only reach the public HTTP gateway.
set -euo pipefail
: "${SUPABASE_URL:?SUPABASE_URL is required}"
: "${SUPABASE_SECRET_KEY:?SUPABASE_SECRET_KEY is required}"

endpoint="${SUPABASE_URL%/}/rest/v1/"
code=$(curl -s -o /dev/null -w "%{http_code}" \
  -H "apikey: $SUPABASE_SECRET_KEY" \
  -H "Authorization: Bearer $SUPABASE_SECRET_KEY" \
  "$endpoint") || code=000

echo "==> Supabase gateway: $endpoint (HTTP $code)"
cat <<'EOF'
Schema is defined in supabase/migrations/0001_fleet_schema.sql and applied
through the Supabase dashboard/CLI. No Drizzle migrations are run at runtime.
EOF
[ "$code" = "200" ]
